# Public front door for COSMOS v2.
#
# COSMOS_SITE_ADDRESS controls how Caddy is exposed:
#   • Set it to your public hostname (e.g. cosmos.example.com) → Caddy obtains and
#     auto-renews a Let's Encrypt certificate and serves HTTPS on :443 (redirecting
#     :80 → :443). This is the standard single-front-door deploy: NO external nginx,
#     Cloudflare tunnel, or load balancer needed — just open inbound 80+443 and point
#     DNS at the host. (Port 80 must be reachable for the ACME HTTP-01 challenge.)
#   • Leave it UNSET (default ":80") → Caddy serves plaintext :80, for a deploy where
#     TLS terminates UPSTREAM (a reverse proxy / tunnel / cloud LB in front of Caddy).
{$COSMOS_SITE_ADDRESS::80} {
	# ── Compression ─────────────────────────────────────────────────────────
	# Measured on a live board: the app's JSON responses went over the wire
	# UNCOMPRESSED while static assets were gzipped, because Next compresses what
	# it serves itself and nothing compressed what it proxies. One board load
	# fetched ~906 KB of JSON, of which /work-items alone was 494 KB carrying no
	# Content-Encoding header at all.
	#
	# This sits above the routes below so it applies to everything proxied. Caddy
	# skips any response that already has a Content-Encoding, so Next's own
	# gzipped assets are not compressed twice, and WebSocket upgrades (the
	# sidecar routes) are 101 responses it does not touch.
	encode zstd gzip
	#
	# An automated review flagged this as a BREACH compression side-channel
	# (MEDIUM). BREACH needs three things together: a secret in a compressed
	# response, attacker-controlled input reflected into that SAME response, and
	# the secret staying CONSTANT across many requests so response size becomes
	# an oracle to search it. The third does not hold here, and the routes say so
	# deliberately:
	#
	#   GET  /calendar-feeds  the select excludes the token -- "a token is shown
	#                         once, at creation, and never again"
	#   POST /calendar-feeds  returns the URL once, freshly minted per request
	#   GET  /api-keys        "NEVER select `keyHash`"
	#   POST /api-keys        plaintext token once, freshly minted per request
	#   integrations          secret config fields are sealed into the vault,
	#                         never written to the plaintext Integration.config
	#   CSRF                  a cookie; `encode` compresses bodies, not headers
	#
	# Hammering those POSTs mints a DIFFERENT secret every time, so there is no
	# oracle. The path exclusions the review suggested (/api/*keys*,
	# /api/*token*) would cost compression on responses carrying no secret.
	#
	# That holds only while it stays true, so it is enforced rather than trusted:
	# src/lib/http/no-stable-secret-in-compressed-get.arch.test.ts fails if any
	# GET handler selects long-lived secret material into its payload. Add such a
	# route and either exclude its path here or stop returning the secret.

	# ── Realtime sidecars ───────────────────────────────────────────────────
	# Matched BEFORE the catch-all below, which would otherwise send these
	# WebSocket upgrades to the app. Each plugin has its OWN sidecar process,
	# own signing key and own port — a ticket for one cannot open the other's
	# rooms.
	#
	# Both routes are no-ops when the sidecar is not running: Caddy answers 502
	# for that path and nothing else is affected, so this file is safe on an
	# instance with neither plugin enabled.
	#
	# NOTE: the pi-planning route existed only as a hand edit on the prod box
	# (compose/Caddyfile showed as modified, with a .bak-presidecar beside it).
	# It is written down here so the repo stops disagreeing with what is running.
	@pi-realtime path /pi-planning/realtime*
	reverse_proxy @pi-realtime pi-planning-sidecar:1234

	@wb-realtime path /whiteboard/realtime*
	reverse_proxy @wb-realtime whiteboard-sidecar:1235

	reverse_proxy cosmos:3000 {
		header_up X-Forwarded-Host {host}
		# The public scheme is ALWAYS https for real traffic — whether Caddy
		# terminates TLS here (COSMOS_SITE_ADDRESS set) or an upstream terminates it
		# and forwards over plaintext :80. Pin it so getPublicOrigin() never emits an
		# http:// origin, which would break OAuth redirect_uri matching + email links.
		header_up X-Forwarded-Proto https
	}
	# Certificate issuance uses the TLS-ALPN-01 challenge (over 443), so inbound
	# port 80 need NOT be open. If 80 IS reachable, Caddy still serves the http→https
	# redirect on it. No-op in the :80 upstream-TLS mode (no ACME there).
	tls {
		issuer acme {
			# ACME CA directory. Defaults to Let's Encrypt (public internet). For an
			# AIRGAPPED / offline deploy, set COSMOS_ACME_CA to your INTERNAL CA's ACME
			# endpoint (e.g. smallstep step-ca) — Caddy then auto-issues AND auto-renews
			# certs against your internal CA with no public internet required.
			dir {$COSMOS_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
			# Trust the internal CA's ACME endpoint (airgap): drop the root PEM into
			# compose/caddy-certs/ and set COSMOS_ACME_CA_ROOT to its in-container path
			# (e.g. /etc/caddy/certs/internal-root.pem). Empty = use system roots.
			trusted_roots {$COSMOS_ACME_CA_ROOT}
			disable_http_challenge
		}
	}
}
